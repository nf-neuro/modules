nextflow_process {

    name "Test Process SEGMENTATION_SHIVAI"
    script "../main.nf"
    process "SEGMENTATION_SHIVAI"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfneuro"
    tag "segmentation"
    tag "segmentation/shivai"

    tag "subworkflows"
    tag "subworkflows/load_test_data"


    setup {
        run("LOAD_TEST_DATA", alias: "LOAD_DATA") {
            script "../../../../../subworkflows/nf-neuro/load_test_data/main.nf"
            process {
                """
                input[0] = channel.from( [ "lesion.zip" ] )
                input[1] = "test.load-test-data"
                """
            }
        }
    }

    test("segmentation - shivai - wmh") {

        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test', single_end:false ], // meta map
                        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true),
                        file("\${test_data_directory}/FLAIR.nii.gz", checkIfExists: true),
                        []
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.wmh_mask.get(0).get(1)).name,
                    file(process.out.report.get(0).get(1)).name,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("segmentation - shivai - wmh - pvs - lacune") {

        when {
            config "./nextflow_all.config"
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test', single_end:false ], // meta map
                        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true),
                        file("\${test_data_directory}/FLAIR.nii.gz", checkIfExists: true),
                        []
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.pvs_mask.get(0).get(1)).name,
                    file(process.out.wmh_mask.get(0).get(1)).name,
                    file(process.out.lac_mask.get(0).get(1)).name,
                    file(process.out.report.get(0).get(1)).name,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("segmentation - shivai - stub") {
        tag "stub"
        options "-stub-run"
        when {
            config "./nextflow_all.config"
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test', single_end:false ], // meta map
                        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true),
                        file("\${test_data_directory}/FLAIR.nii.gz", checkIfExists: true),
                        []
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.pvs_mask.get(0).get(1)).name,
                    file(process.out.wmh_mask.get(0).get(1)).name,
                    file(process.out.lac_mask.get(0).get(1)).name,
                    file(process.out.report.get(0).get(1)).name,
                    process.out.versions
                ).match() }
            )
        }
    }
}
