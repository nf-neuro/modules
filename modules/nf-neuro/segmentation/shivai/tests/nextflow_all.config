process {
    withName: "SEGMENTATION_SHIVA" {
        ext.prediction = "wmh pvs lac"
        ext.use_cpu = true
        ext.threshold_pvs = 0.5
        ext.threshold_wmh = 0.2
        ext.threshold_lac = 0.5
        ext.min_pvs_size = 5
        ext.min_wmh_size = 1
        ext.min_lac_size = 3
        ext.voxels_tolerance = "0 0 0"
    }
}
