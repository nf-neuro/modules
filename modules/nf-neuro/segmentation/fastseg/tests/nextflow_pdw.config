process {
    publishDir = { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }

    withName: "SEGMENTATION_FASTSEG" {
        ext.nb_class = 4
        ext.nb_iter = 4
        ext.low_pass = 20
        ext.fhard = 0.02
        ext.hyper = 0.1
        ext.nobias = false
        ext.init = 15
        ext.mixel = 0.3
        ext.fixed = 4
    }
}
