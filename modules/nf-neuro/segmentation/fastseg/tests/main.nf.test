nextflow_process {

    name "Test Process SEGMENTATION_FASTSEG"
    script "../main.nf"
    process "SEGMENTATION_FASTSEG"

    tag "modules"
    tag "modules_nfneuro"
    tag "segmentation"
    tag "segmentation/fastseg"

    tag "subworkflows"
    tag "subworkflows/load_test_data"

    setup {
        run("LOAD_TEST_DATA", alias: "LOAD_DATA") {
            script "../../../../../subworkflows/nf-neuro/load_test_data/main.nf"
            process {
                """
                input[0] = channel.from( [ "T1w.zip" ] )
                input[1] = "test.load-test-data"
                """
            }
        }
    }

    test("segmentation - fastseg - T2w") {
        config "./nextflow_t2w.config"
        when {
            process {
                """
                //input[0] = LOAD_DATA.out.test_data_directory.map{
                //    test_data_directory -> [
                //        [ id:'test', single_end:false ], // meta map
                //        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true,),
                //        [],
                //        1
                //    ]
                //}
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file("/Users/anthonygagnon/Downloads/tpl-MNI152Lin_space-MNI_res-02_T2w.nii", checkIfExists: true),
                    [],
                    2
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    niftiMD5SUM(process.out.wm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.wm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_map.get(0).get(1)),
                    process.out.versions
                ).match() }
            )
        }
    }
    test("segmentation - fastseg - T1w") {
        config "./nextflow_t1w.config"
        when {
            process {
                """
                //input[0] = LOAD_DATA.out.test_data_directory.map{
                //    test_data_directory -> [
                //        [ id:'test', single_end:false ], // meta map
                //        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true,),
                //        [],
                //        1
                //    ]
                //}
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file("/Users/anthonygagnon/Downloads/tpl-MNI152Lin_space-MNI_res-02_T1w.nii", checkIfExists: true,),
                    [],
                    1
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    niftiMD5SUM(process.out.wm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.wm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_map.get(0).get(1)),
                    process.out.versions
                ).match() }
            )
        }
    }
    test("segmentation - fastseg - PDw") {
        config "./nextflow_pdw.config"
        when {
            process {
                """
                //input[0] = LOAD_DATA.out.test_data_directory.map{
                //    test_data_directory -> [
                //        [ id:'test', single_end:false ], // meta map
                //        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true,),
                //        [],
                //        1
                //    ]
                //}
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file("/Users/anthonygagnon/Downloads/tpl-MNI152Lin_space-MNI_res-02_PDw.nii", checkIfExists: true,),
                    [],
                    3
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    niftiMD5SUM(process.out.wm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.wm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_map.get(0).get(1)),
                    process.out.versions
                ).match() }
            )
        }
    }
    test("segmentation - fastseg - lesion") {
        config "./nextflow_t1w.config"
        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test', single_end:false ], // meta map
                        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true,),
                        file("\${test_data_directory}/T1w_mask.nii.gz", checkIfExists: true),
                        1
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    niftiMD5SUM(process.out.wm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_mask.get(0).get(1)),
                    niftiMD5SUM(process.out.wm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.gm_map.get(0).get(1)),
                    niftiMD5SUM(process.out.csf_map.get(0).get(1)),
                    process.out.versions
                ).match() }
            )
        }
    }
    test("segmentation - fastseg - stub-run") {
        tag "stub"
        options "-stub-run"
        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.map{
                    test_data_directory -> [
                        [ id:'test', single_end:false ], // meta map
                        file("\${test_data_directory}/T1w.nii.gz", checkIfExists: true,),
                        [],
                        1
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }
}
