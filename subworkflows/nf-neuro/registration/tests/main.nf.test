                            } ]
                        }
                ).match() },
                { assert workflow.out
                    .findAll{ channel -> !channel.key.isInteger() }
                    .every{ channel -> ["ref_warped",
                                        "segmentation",
                                        "ref_segmentation"].contains(channel.key)
                        ? channel.value.size() == 0
                        : channel.value.every{ subject -> subject instanceof ArrayList
                            ? subject.every()
                            : subject } } }
            )
        }
    }

